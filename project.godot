; Engine configuration file.
; 공룡을 찾아라! — Godot 4 프로젝트

config_version=5

[application]

config/name="공룡을 찾아라!"
config/description="집 안 여러 방에 숨은 공룡을 찾는 아이용 게임"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
; 0=가로, 1=세로, 4=가로(센서). 아이가 아무 방향으로 잡아도 되게 4.
window/handheld/orientation=4

[gui]

theme/custom_font="res://fonts/DinoKR.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
; 공룡 그림(512px)을 작게 그리므로 밉맵으로 부드럽게 줄인다
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.984, 0.914, 0.812, 1)
